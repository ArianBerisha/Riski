  "probability_model": {
    "hazard_to_probability": "P = 1 - exp(-H)",
    "micromort": "M = 1,000,000 * P",
    "micromort_min": 0,
    "micromort_max": 1000000,
    "scale_ticks": [
      0.01,
      0.1,
      1,
      10,
      100,
      1000,
      10000,
      100000,
      1000000
    ],
    "scale_mapping": "position_percent = clamp(12.5 * (log10(max(M,0.01)) + 2), 0, 100)",
    "bands": [
      {
        "max_exclusive": 0.1,
        "de": "Sehr niedrig"
      },
      {
        "max_exclusive": 1,
        "de": "Niedrig"
      },
      {
        "max_exclusive": 10,
        "de": "Mittel"
      },
      {
        "max_exclusive": 100,
        "de": "Hoch"
      },
      {
        "max_exclusive": 1000,
        "de": "Sehr hoch"
      },
      {
        "max_exclusive": 10000,
        "de": "Extrem"
      },
      {
        "max_exclusive": 100000,
        "de": "Sehr extrem"
      },
      {
        "max_inclusive": 1000000,
        "de": "Nahezu sicher im Modell"
      }
    ],
    "extrapolation_warning_km_per_day": 2000
  },
  "display": {
    "micromort_grouping": "narrow no-break space",
    "decimal_separator_de": ",",
    "example": "5 000,0000 µMort = 0,5000 % = about 1:200",
    "scale_max_micromort": 1000000
  },
  "pkw_accumulation": {
    "previous_plateau": "The old model used P(at least one injury crash) times one-crash fatality severity, causing a plateau at 5,000 µMort for urban severity 5/1000.",
    "correct_equation": "H_fatal = distance * injury_crash_rate * crash_modifiers * fatality_severity * severity_modifiers; P_fatal = 1 - exp(-H_fatal)",
    "limit": "As distance tends to infinity, P_fatal tends to 1 and micromorts tend to 1,000,000."
  }
}